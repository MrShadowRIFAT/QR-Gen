{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/api.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/ajax/*.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/pdf/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/pdf/?$",
      "dest": "/api/pdf/index.php"
    },
    {
      "src": "^/API/?$",
      "dest": "/api/api.php"
    },
    {
      "src": "^/ajax/(.*\\.php)$",
      "dest": "/api/ajax/$1"
    },
    {
      "src": "^/index\\.php$",
      "dest": "/api/index.php"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/index.php"
    }
  ]
}
