{
  "version": 2,
  "functions": {
    "**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/index.php"
    },
    {
      "src": "^/pdf/?$",
      "dest": "/pdf/index.php"
    },
    {
      "src": "^/API/?$",
      "dest": "/API/index.php"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*\\.php)$",
      "dest": "/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.php"
    }
  ]
}
